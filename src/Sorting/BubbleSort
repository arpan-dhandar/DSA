
public class Main {
    public static void main(String[] args) {

        int arr[] = {21, 45, 89, 63, 44, 28};
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            int didSwap = 0;
            for (int j = 0; j < n - i - 1; j++) {

                if (arr[j] > arr[j + 1]) {

                    int temp = arr[j + 1];
                    arr[j + 1] = arr[j];
                    arr[j] = temp;
                didSwap = 1;
                }
            }
            if( didSwap == 0){
                break;
            }
        }

        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}
